# Copy to .env and fill in. Only DATABASE_URL and BETTER_AUTH_SECRET are required locally.
DATABASE_URL=postgres://postgres@localhost:5432/bondhu
BETTER_AUTH_SECRET=change-me-to-a-random-32-plus-character-string
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SMS (console prints codes in dev; twilio for production)
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Email — required in production (verification + password-reset codes).
# Register/verify this sender in Brevo before using it.
# In development, emails are printed to the console when BREVO_API_KEY is empty.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=hello@example.com
# BREVO_SENDER_NAME=APON

# Cloudinary — image & file uploads (server-only; never prefix with NEXT_PUBLIC_).
# Find these in the Cloudinary console → Settings → API Keys.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# …or a single URL instead of the three above:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_FOLDER=apon

# 0 = Sunday … 6 = Saturday
MATCHING_DAY=1
